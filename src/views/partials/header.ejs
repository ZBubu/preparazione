<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>

<% const isActive = (p) => currentPath === p || currentPath.startsWith(p + '/') ? 'active' : ''; %>

<nav class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">Mappa Aule</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav nav nav-pills">
        <% if(!utente) { %>
        <li class="nav-item">
          <a class="nav-link <%= isActive('/login') %>" href="/login">Login</a>
        </li>
        <% } %>

        <% if(utente && utente.type === "admin") { %>
        <li class="nav-item">
          <a class="nav-link <%= isActive('/admin/utenti') %>" href="/admin/utenti">Gestione utenti</a>
        </li>
        <% } %>

        <% if(utente) { %>
          <li class="nav-item">
            <a class="nav-link <%= isActive('/mappa') %>" href="/mappa">Mappa</a>
          </li>
        <li class="nav-item">
          <form action="/logout" method="POST" class="d-inline">
            <button type="submit" class="nav-link btn btn-link">Logout</button>
          </form>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>